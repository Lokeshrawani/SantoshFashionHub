rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'santoshrawani123@gmail.com'
        && request.auth.token.email_verified == true;
    }
    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // Orders are written only by trusted Cloud Functions using the Admin SDK.
    match /orders/{orderId} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /customers/{customerId} {
      allow read: if isOwner(customerId) || isAdmin();
      allow create: if isOwner(customerId)
        && request.resource.data.role == 'customer'
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'displayName', 'phone', 'createdAt', 'updatedAt', 'role'
        ]);
      allow update: if isOwner(customerId)
        && resource.data.role == 'customer'
        && request.resource.data.role == resource.data.role
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'displayName', 'phone', 'createdAt', 'updatedAt', 'role'
        ]);
      allow delete: if false;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId)
        && (!('role' in request.resource.data) || request.resource.data.role == 'customer');
      allow delete: if false;
    }

    match /collectionPhotos/{portalId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /collectionPhotoSlots/{slotId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /razorpayWebhookEvents/{eventId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}